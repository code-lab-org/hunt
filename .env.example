# Copy to .env and fill in before running `docker compose up -d`.

# Public domain name for the game; its DNS record must point at this server.
HUNT_DOMAIN=hunt.example.com

# Email address Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=admin@example.com

# Password for the administrator interface (/admin.html).
HUNT_ADMIN_PASSWORD=change-me

# Pass code players enter to join the game.
HUNT_USER_PASSCODE=change-me

# Optional: use the Let's Encrypt staging server while testing to avoid rate limits.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
